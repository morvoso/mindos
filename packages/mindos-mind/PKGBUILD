# Maintainer: MindOS <build@mindos.local>
# The Mind: mindd (local-LLM system daemon) and the `mind` CLI, built from ../../mindd.
pkgname=mindos-mind
pkgver=0.1.0
pkgrel=20
pkgdesc="MindOS Mind: local LLM system daemon (mindd) and its CLI (mind)"
arch=(x86_64)
url="https://github.com/morvoso/mindos"
license=('LicenseRef-MindOS')
depends=(glibc gcc-libs llama-cpp ggml-vulkan ggml-blas pacman systemd pciutils coreutils util-linux
         sudo flatpak curl)
# CUDA and build toolchains are optional; games do not need either.
optdepends=('paru: optional community package support' 'base-devel: build optional community packages'
            'ggml-cuda: CUDA backend for llama-server on NVIDIA GPUs (faster than Vulkan)')
makedepends=(rust clang lld rsync)
backup=(etc/mindos/mind.toml etc/mindos/model-catalog.json etc/mindos/pkg.conf)
install=mindos-mind.install
options=(!lto !debug)
source=(mind.toml model-catalog.json pkg.conf mindd.service mindos.sysusers mindos.tmpfiles mindos-pkg 20-mindos-build.sudoers
        96-mindos-update-mark.hook update-mark)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP)

_srcroot="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export CARGO_HOME="${CARGO_HOME:-$_srcroot/build/cargo-home}"

prepare() {
  rm -rf "$srcdir/mindd"
  rsync -a --exclude target --exclude .git -- "$_srcroot/mindd/" "$srcdir/mindd/"
  cd "$srcdir/mindd"
  cargo fetch --locked
}

build() {
  cd "$srcdir/mindd"
  local cpu
  case "${MINDOS_CPU:-generic}" in
    generic) cpu=x86-64 ;;
    native) cpu=native ;;
    *) echo "MINDOS_CPU must be generic or native" >&2; return 1 ;;
  esac
  export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=$cpu"
  cargo build --jobs "${MINDOS_JOBS:-$(nproc)}" --release --locked --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/mindd" "$pkgdir/usr/bin/mindd"
  install -Dm755 "$srcdir/target/release/mind"  "$pkgdir/usr/bin/mind"
  install -Dm644 "$srcdir/mindd.service"  "$pkgdir/usr/lib/systemd/system/mindd.service"
  install -Dm644 "$srcdir/mindos.sysusers" "$pkgdir/usr/lib/sysusers.d/mindos.conf"
  install -Dm644 "$srcdir/mindos.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/mindos.conf"
  install -Dm644 "$srcdir/mind.toml" "$pkgdir/etc/mindos/mind.toml"
  # The models the Settings app offers to download (Qwen3.5, Apache-2.0).
  install -Dm644 "$srcdir/model-catalog.json" "$pkgdir/etc/mindos/model-catalog.json"
  install -Dm755 "$srcdir/mindos-pkg" "$pkgdir/usr/bin/mindos-pkg"
  # Whether mindos-pkg may fall back to the AUR. Off by default.
  install -Dm644 "$srcdir/pkg.conf" "$pkgdir/etc/mindos/pkg.conf"
  install -Dm440 "$srcdir/20-mindos-build.sudoers" "$pkgdir/etc/sudoers.d/20-mindos-build"
  # Every pacman transaction is recorded so mindd can verify the system after it.
  install -Dm644 "$srcdir/96-mindos-update-mark.hook" "$pkgdir/usr/share/libalpm/hooks/96-mindos-update-mark.hook"
  install -Dm755 "$srcdir/update-mark" "$pkgdir/usr/lib/mindos/update-mark"
  install -dm755 "$pkgdir/var/lib/mindos/models"
  install -Dm644 "$srcdir/mindd/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md" 2>/dev/null || true

  # The MindOS licence: a custom licence, so pacman wants it under the package.
  install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
