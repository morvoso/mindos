post_install() {
  systemd-sysusers mindos.conf >/dev/null 2>&1 || true
  systemd-tmpfiles --create mindos.conf >/dev/null 2>&1 || true
  cat <<'MSG'
==> MindOS Mind installed.
    * The ISO ships Qwen3.5 4B in /var/lib/mindos/models/ (Apache-2.0). Any
      GGUF placed there works too (default.gguf wins, else the largest one that
      fits the GPU); then: systemctl enable --now mindd
    * Settings > Mind (or `mind models` / `mind model` / `mind download`) switches
      models and downloads others from /etc/mindos/model-catalog.json.
    * Users who may talk to the Mind must be in group "mindos":
        usermod -aG mindos <user>
    * Then: mind chat | mind update | mind doctor
MSG
}
post_upgrade() {
  systemd-sysusers mindos.conf >/dev/null 2>&1 || true
  systemd-tmpfiles --create mindos.conf >/dev/null 2>&1 || true
}
