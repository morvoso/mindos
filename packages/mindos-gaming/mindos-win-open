#!/usr/bin/python3
"""Graphical Windows file handler; Wine and per-app prefixes stay behind the UI."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

# Shortcuts the program itself is not: its uninstaller, its manual, its website.
NOT_THE_PROGRAM = ('uninstall', 'readme', 'help', 'website', 'download', 'documentation', 'release notes')

RUNTIME_LABELS = {
    'dotnetdesktop6': 'the Microsoft .NET 6 Desktop runtime',
    'dotnetdesktop7': 'the Microsoft .NET 7 Desktop runtime',
    'dotnetdesktop8': 'the Microsoft .NET 8 Desktop runtime',
    'dotnetdesktop9': 'the Microsoft .NET 9 Desktop runtime',
}


def dialog(*args):
    return subprocess.run(['zenity', '--title=Windows apps', *args], text=True, capture_output=True)


def progress(text):
    """The pulsing popup that stays up while something slow happens."""
    return subprocess.Popen(['zenity', '--progress', '--pulsate', '--no-cancel', '--auto-close',
                             '--title=Windows apps', '--text=' + text],
                            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def pick(start=None):
    args = ['--file-selection', '--file-filter=Windows programs | *.exe *.EXE *.msi *.MSI']
    if start:
        args.append('--filename=' + str(start) + '/')
    result = dialog(*args)
    return Path(result.stdout.strip()).resolve() if result.returncode == 0 and result.stdout.strip() else None


def win(*args, **kwargs):
    return subprocess.run(['mindos-win', *args], text=True, capture_output=True, **kwargs)


def desktop_quote(value):
    # Exec has two escaping layers: desktop-entry strings, then quoted args.
    argument = '"' + ''.join('\\' + c if c in '\\"`$' else c for c in value) + '"'
    return argument.replace('\\', '\\\\').replace('%', '%%')


def shortcut(name, slug, program, data):
    apps = data / 'applications'
    apps.mkdir(parents=True, exist_ok=True)
    entry = apps / f'mindos-win-{slug}.desktop'
    args = ['mindos-win', 'run', slug, str(program)]
    text = ('[Desktop Entry]\nType=Application\n'
            f'Name={name.replace(chr(10), " ").replace(chr(13), " ")}\n'
            'Comment=Windows application\nIcon=wine\nTerminal=false\n'
            'Categories=Utility;\n'
            f'StartupWMClass={program.name}\n'
            'Exec=' + ' '.join(desktop_quote(a) for a in args) + '\n')
    with tempfile.NamedTemporaryFile(mode='w', dir=apps, delete=False) as output:
        output.write(text)
        temporary = Path(output.name)
    temporary.chmod(0o755)
    temporary.replace(entry)
    return entry


def installed(slug):
    """What `mindos-win list --json` knows about one prefix."""
    result = win('list', '--json')
    if result.returncode:
        return None
    try:
        for app in json.loads(result.stdout):
            if app['slug'] == slug:
                return app
    except (ValueError, KeyError):
        pass
    return None


def main_entry(app):
    """The Start Menu shortcut that starts the program rather than its extras."""
    entries = [e for e in app.get('entries', [])
               if not any(word in e['name'].lower() for word in NOT_THE_PROGRAM)]
    if not entries:
        entries = app.get('entries', [])
    return min(entries, key=lambda e: (len(e['name']), e['name'])) if entries else None


def add_runtime(slug, name):
    """Windows ships its runtimes with the system; a fresh Wine prefix has none,
    and a program that needs one closes the moment it is started. Offer it in
    the same breath as the install, so the app opens the first time it is asked."""
    result = win('needs', slug)
    verb = result.stdout.strip().split('\n')[0] if result.returncode == 0 else ''
    if not verb:
        return
    label = RUNTIME_LABELS.get(verb, 'a Microsoft runtime')
    answer = dialog('--question', '--width=460', '--ok-label=Install it',
                    '--cancel-label=Not now',
                    f'--text={name} needs {label} before it can start.\n'
                    'This is a one-off download of about 60 MB.')
    if answer.returncode:
        return
    bar = progress(f'Adding {label} to {name}. This takes a few minutes.')
    try:
        outcome = win('provide', slug, verb)
    finally:
        bar.communicate(b'100\n')
    if outcome.returncode:
        dialog('--warning', '--no-markup', '--width=460',
               f'--text={label} could not be added. {name} may not start until it is.')


def offer_to_open(name, entry):
    answer = dialog('--question', '--width=460', '--ok-label=Open now', '--cancel-label=Close',
                    f'--text={name} is installed.\n'
                    'You will find it in Mind and on the desktop, like any other app.')
    if answer.returncode == 0 and entry:
        subprocess.Popen(['gio', 'launch', entry['file']], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    if os.geteuid() == 0:
        raise ValueError('Open Windows apps from your desktop account.')
    program = Path(sys.argv[1]).expanduser().resolve() if len(sys.argv) > 1 else pick()
    if program is None:
        return
    if not program.is_file() or program.suffix.lower() not in ('.exe', '.msi'):
        raise ValueError('Choose a Windows .exe or .msi file.')
    if any(c in str(program) for c in '\n\r'):
        raise ValueError('Rename this file to remove line breaks from its path.')
    choice = dialog('--list', '--radiolist', '--width=540', '--height=270', '--print-column=2',
                    '--text=How would you like to open this Windows program?',
                    '--column=Select', '--column=Action', '--column=Description',
                    'TRUE', 'Install', 'Run a setup program and add its shortcuts',
                    'FALSE', 'Run app', 'Add a portable app and open it')
    if choice.returncode:
        return
    action = choice.stdout.strip()
    if action == 'Run app' and program.suffix.lower() == '.msi':
        raise ValueError('MSI files are installers. Choose Install.')
    name = program.stem
    slug = re.sub(r'[^a-z0-9]+', '-', name.lower().replace('+', '-plus')).strip('-') or 'windows-app'
    data = Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share')))
    root = Path(os.environ.get('MINDOS_WIN_ROOT', str(data / 'mindos/win')))
    prefix = root / slug
    # A portable program must not unexpectedly share another program's prefix.
    if prefix.exists():
        confirm = dialog('--question', '--text=An app with this name is already set up. Use its existing settings?', '--default-cancel')
        if confirm.returncode:
            return
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'mindos'
    state.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', prefix='windows-', suffix='.log', dir=state, delete=False) as log:
        log_path = Path(log.name)
        bar = progress('Setting up your app. Follow the Windows installer if it opens.')
        try:
            args = ['mindos-win', 'install', str(program)] if action == 'Install' else ['mindos-win', 'create', name]
            result = subprocess.run(args, stdout=log, stderr=subprocess.STDOUT)
        finally:
            bar.communicate(b'100\n')
    if result.returncode:
        raise ValueError(f'The Windows program could not be set up. Details are saved in {log_path}')
    if action == 'Run app':
        entry = shortcut(name, slug, program, data)
        add_runtime(slug, name)
        subprocess.Popen(['gio', 'launch', str(entry)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    # The program named itself during the install; the file it arrived as
    # ("LINQPad9Setup.exe") is not what anyone calls it.
    app = installed(slug)
    if app:
        name = app['name']
    entry = main_entry(app) if app else None
    if entry is None:
        # Wine may not create Start Menu shortcuts (some installers are portable).
        answer = dialog('--question', '--text=Setup finished without adding an app shortcut. Choose the installed program to add it to Mind?', '--default-cancel')
        if answer.returncode == 0:
            target = pick(prefix / 'drive_c')
            if target and target.is_file() and target.suffix.lower() == '.exe':
                added = shortcut(name, slug, target, data)
                entry = {'file': str(added), 'name': name}
    add_runtime(slug, name)
    offer_to_open(name, entry)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        dialog('--error', '--no-markup', '--text=' + str(error))
        sys.exit(1)
