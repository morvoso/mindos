#!/usr/bin/env python3
"""MindOS gaming session and integration service."""
from pathlib import Path
import json
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent if (Path(__file__).resolve().parent/'play').is_dir() else Path('/usr/lib/mindos')))
from play.service import main
try:
    sys.exit(main())
except Exception as e:
    print(json.dumps({'error':str(e)}))
    sys.exit(1)
