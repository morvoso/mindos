# Maintainer: MindOS <build@mindos.local>
# The MindOS compositor (Smithay based, Wayland + XWayland on DRM/KMS), built from ../../mindwm.
pkgname=mindwm
pkgver=0.1.0
pkgrel=40
pkgdesc="MindOS compositor: game-mode Wayland/XWayland compositor with the Mind bar"
arch=(x86_64)
url="https://github.com/morvoso/mindos"
license=('LicenseRef-MindOS' MIT OFL-1.1 Bitstream-Vera)
depends=(glibc gcc-libs wayland libinput libxkbcommon mesa libglvnd libdrm pixman seatd
         systemd-libs xorg-xwayland glib2 libevdev libgudev gdk-pixbuf2 librsvg)
makedepends=(rust clang lld rsync wayland-protocols pkgconf)
options=(!lto !debug)

_srcroot="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export CARGO_HOME="${CARGO_HOME:-$_srcroot/build/cargo-home}"

prepare() {
  rm -rf "$srcdir/mindwm"
  rsync -a --exclude target --exclude .git -- "$_srcroot/mindwm/" "$srcdir/mindwm/"
  cd "$srcdir/mindwm"
  cargo fetch
}

build() {
  cd "$srcdir/mindwm"
  local cpu
  case "${MINDOS_CPU:-generic}" in
    generic) cpu=x86-64 ;;
    native) cpu=native ;;
    *) echo "MINDOS_CPU must be generic or native" >&2; return 1 ;;
  esac
  export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=$cpu"
  cargo build --jobs "${MINDOS_JOBS:-$(nproc)}" --release --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/mindwm" "$pkgdir/usr/bin/mindwm"
  if [[ -f "$srcdir/mindwm/README.md" ]]; then
    install -Dm644 "$srcdir/mindwm/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  fi
  # Inter, JetBrains Mono, Orbitron (SIL OFL) and DejaVu Sans (Bitstream Vera)
  # are compiled into the binary by src/text.rs, so their licences ship with it.
  install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
  install -m644 "$srcdir/mindwm/resources"/OFL-*.txt "$srcdir/mindwm/resources"/LICENSE-*.txt \
    "$pkgdir/usr/share/licenses/$pkgname/"
  # mindwm is derived from Smithay's anvil; the MIT notice travels with the binary.
  install -m644 "$srcdir/mindwm/LICENSE-smithay.txt" "$pkgdir/usr/share/licenses/$pkgname/"

  # The MindOS licence: a custom licence, so pacman wants it under the package.
  install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
