# MindOS defaults for GSettings (/usr/share/glib-2.0/schemas/, compiled by the
# glib-compile-schemas pacman hook). xdg-desktop-portal-gtk reports these to
# every app that asks the Settings portal: dark colour scheme, the MindOS fonts.
[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='teal'
# Adwaita, not Adwaita-dark: GTK 3 on Wayland takes the theme name from here
# and has no built-in theme of that name (see gtk-settings.ini).
gtk-theme='Adwaita'
icon-theme='breeze-dark'
cursor-theme='Adwaita'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrains Mono 11'
font-antialiasing='grayscale'
font-hinting='slight'

[org.gnome.desktop.wm.preferences]
button-layout=':minimize,maximize,close'
