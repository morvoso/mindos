#!/bin/bash
# mindos-session: set up the environment for Wayland-native applications and
# start the MindOS compositor on the current seat. Started by greetd.

# The login environment. greetd used to source these itself (its
# general.source_profile), but it does that in /bin/sh, where a failed `.` is
# fatal: one stale line in ~/.profile -- a rustup env file that is not there,
# say -- ended the session before this script ever ran, and the login screen
# came back with nothing logged anywhere. Sourced here in bash instead, a bad
# line is one message on the way past. /etc/profile is also what sets PATH.
for profile in /etc/profile "$HOME/.profile"; do
  # shellcheck disable=SC1090
  [ -r "$profile" ] && . "$profile"
done
export PATH="${PATH:-/usr/local/sbin:/usr/local/bin:/usr/bin}"

export XDG_SESSION_TYPE=wayland
# MindOS application defaults (GTK settings, ...) come first; /etc/xdg stays as the fallback
case ":${XDG_CONFIG_DIRS:-}:" in
  *:/etc/mindos/xdg:*) ;;
  *) export XDG_CONFIG_DIRS="/etc/mindos/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
esac
export XDG_CURRENT_DESKTOP=MindOS
export XDG_SESSION_DESKTOP=mindos
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export SDL_VIDEODRIVER="wayland,x11"
export GDK_BACKEND="wayland,x11"
export _JAVA_AWT_WM_NONREPARENTING=1
export CLUTTER_BACKEND=wayland
export ELECTRON_OZONE_PLATFORM_HINT=auto
# The pointer: the MindOS cursor theme (animated, dark glass with a cyan
# pulse) at the size chosen in Settings. GSettings is the source of truth --
# GTK applications follow it live through the settings portal, mindwm keeps a
# copy in its own preferences, and these variables are what everything else
# (SDL, Qt, XWayland) reads once, here.
mindos_gsetting() {
  local v
  v=$(gsettings get org.gnome.desktop.interface "$1" 2>/dev/null) || return 0
  # strings come back quoted, integers bare
  v=${v#\'}; v=${v%\'}
  [[ $v == uint32* ]] && v=${v#uint32 }
  printf '%s' "$v"
}
export XCURSOR_THEME="${XCURSOR_THEME:-$(mindos_gsetting cursor-theme)}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-$(mindos_gsetting cursor-size)}"
export XCURSOR_THEME="${XCURSOR_THEME:-MindOS}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# Site and user overrides (plain "export KEY=value" lines).
for f in /etc/mindos/session-env "${XDG_CONFIG_HOME:-$HOME/.config}/mindos/session-env"; do
  # shellcheck disable=SC1090
  [[ -r $f ]] && . "$f"
done

# The user manager can outlive a login. Stop stale session services before
# publishing a new display, and stop them on logout or compositor failure.
# Keep a parent process so an ordinary compositor exit reaches this cleanup.
compositor_pid=
cleanup_session() {
  trap - EXIT HUP INT TERM
  systemctl --user stop mindos-session.target 2>/dev/null || true
  if [[ -n $compositor_pid ]]; then kill -TERM "$compositor_pid" 2>/dev/null || true; fi
  if [[ -n $compositor_pid ]]; then wait "$compositor_pid" 2>/dev/null || true; fi
}
trap cleanup_session EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# What the session itself has to say goes to the journal: journalctl -t mindos-session
session_log() {
  local priority=$1
  shift
  if command -v systemd-cat >/dev/null 2>&1; then
    printf '%s\n' "$*" | systemd-cat -t mindos-session -p "$priority"
  else
    printf 'mindos-session: %s\n' "$*" >&2
  fi
}

# A compositor crash takes every window with it, but it does not have to take
# the login too. When mindwm dies abnormally -- killed by a signal (the loop
# watchdog aborts a frozen compositor: SIGABRT, status 134; a segfault is 139)
# or exiting non-zero (70 when it cannot get past a panic) -- the desktop starts
# again in this session instead of dropping to the greeter. Stopping
# mindos-session.target takes the shell, the portals and the autostart
# applications down with the old display, and the new compositor's
# session-startup brings them back against the new one, as at login. Exit 0 is
# a logout and 2 a usage error; a signal to this script (HUP, INT, TERM: a
# logout, greetd stopping) ends the session through the traps above and never
# gets here. A compositor that cannot stay up is not started forever: after
# three restarts inside ten minutes the session ends with the compositor's
# status, and greetd shows the greeter.
restart_limit=3
restart_window=600
restarts=()
while :; do
  systemctl --user stop mindos-session.target 2>/dev/null || true

  # Compositor output goes to the journal: journalctl -t mindwm
  if command -v systemd-cat >/dev/null 2>&1; then
    systemd-cat -t mindwm mindwm --tty-udev &
  else
    mindwm --tty-udev &
  fi
  compositor_pid=$!
  wait "$compositor_pid"
  compositor_status=$?
  dead_pid=$compositor_pid
  compositor_pid=
  case $compositor_status in
    0|2) exit "$compositor_status" ;;
  esac

  if (( compositor_status > 128 )) && signal=$(kill -l "$((compositor_status - 128))" 2>/dev/null); then
    how="mindwm (pid $dead_pid) was killed by SIG$signal (status $compositor_status)"
  else
    how="mindwm (pid $dead_pid) exited with status $compositor_status"
  fi
  # Seconds since boot: a clock that NTP or the user setting the time cannot move.
  read -r now _ </proc/uptime
  now=${now%.*}
  recent=()
  for at in "${restarts[@]}"; do
    if (( now - at < restart_window )); then recent+=("$at"); fi
  done
  restarts=("${recent[@]}")
  if (( ${#restarts[@]} >= restart_limit )); then
    session_log err "$how after $restart_limit restarts in $((restart_window / 60)) minutes; ending the session"
    exit "$compositor_status"
  fi
  restarts+=("$now")
  session_log warning "$how; starting it again (restart ${#restarts[@]} of $restart_limit in $((restart_window / 60)) minutes)"
  # A moment for logind to take the seat back from the dead compositor before
  # the next one asks for it. `wait`, so a logout meanwhile is not held up.
  sleep 2 &
  wait $!
done
