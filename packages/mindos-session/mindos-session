#!/bin/bash
# mindos-session: set up the environment for Wayland-native applications and
# start the MindOS compositor on the current seat. Started by greetd.

export XDG_SESSION_TYPE=wayland
# MindOS application defaults (GTK settings, ...) come first; /etc/xdg stays as the fallback
case ":${XDG_CONFIG_DIRS:-}:" in
  *:/etc/mindos/xdg:*) ;;
  *) export XDG_CONFIG_DIRS="/etc/mindos/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
esac
export XDG_CURRENT_DESKTOP=MindOS
export XDG_SESSION_DESKTOP=mindos
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export SDL_VIDEODRIVER="wayland,x11"
export GDK_BACKEND="wayland,x11"
export _JAVA_AWT_WM_NONREPARENTING=1
export CLUTTER_BACKEND=wayland
export ELECTRON_OZONE_PLATFORM_HINT=auto
# The pointer: the MindOS cursor theme (animated, dark glass with a cyan
# pulse) at the size chosen in Settings. GSettings is the source of truth --
# GTK applications follow it live through the settings portal, mindwm keeps a
# copy in its own preferences, and these variables are what everything else
# (SDL, Qt, XWayland) reads once, here.
mindos_gsetting() {
  local v
  v=$(gsettings get org.gnome.desktop.interface "$1" 2>/dev/null) || return 0
  # strings come back quoted, integers bare
  v=${v#\'}; v=${v%\'}
  [[ $v == uint32* ]] && v=${v#uint32 }
  printf '%s' "$v"
}
export XCURSOR_THEME="${XCURSOR_THEME:-$(mindos_gsetting cursor-theme)}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-$(mindos_gsetting cursor-size)}"
export XCURSOR_THEME="${XCURSOR_THEME:-MindOS}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# Site and user overrides (plain "export KEY=value" lines).
for f in /etc/mindos/session-env "${XDG_CONFIG_HOME:-$HOME/.config}/mindos/session-env"; do
  # shellcheck disable=SC1090
  [[ -r $f ]] && . "$f"
done

# The user manager can outlive a login. Stop stale session services before
# publishing a new display, and stop them on logout or compositor failure.
# Keep a parent process so an ordinary compositor exit reaches this cleanup.
compositor_pid=
cleanup_session() {
  trap - EXIT HUP INT TERM
  systemctl --user stop mindos-session.target 2>/dev/null || true
  if [[ -n $compositor_pid ]]; then kill -TERM "$compositor_pid" 2>/dev/null || true; fi
  if [[ -n $compositor_pid ]]; then wait "$compositor_pid" 2>/dev/null || true; fi
}
trap cleanup_session EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
systemctl --user stop mindos-session.target 2>/dev/null || true

# Compositor output goes to the journal: journalctl -t mindwm
if command -v systemd-cat >/dev/null 2>&1; then
  systemd-cat -t mindwm mindwm --tty-udev &
else
  mindwm --tty-udev &
fi
compositor_pid=$!
wait "$compositor_pid"
compositor_status=$?
compositor_pid=
exit "$compositor_status"
