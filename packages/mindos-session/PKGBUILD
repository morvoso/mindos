# Maintainer: MindOS <build@mindos.local>
pkgname=mindos-session
pkgver=0.1.0
pkgrel=10
pkgdesc="MindOS session: greetd configuration, session launcher, compositor defaults and the dark-mode defaults for GTK, the portal and Firefox"
arch=(any)
url="https://mindos.local"
license=(MIT)
depends=(mindwm mindos-mind greetd greetd-agreety seatd dbus xorg-xwayland foot polkit
         xdg-user-dirs
         ttf-jetbrains-mono noto-fonts noto-fonts-emoji inter-font
         wl-clipboard grim slurp pipewire wireplumber pipewire-pulse pipewire-alsa pipewire-jack
         pamixer brightnessctl util-linux
         xdg-desktop-portal xdg-desktop-portal-gtk dconf gsettings-desktop-schemas)
optdepends=('firefox: gets the MindOS dark defaults from /usr/lib/firefox/defaults/pref/mindos.js')
backup=(etc/mindos/greetd.toml etc/mindos/mindwm.toml etc/mindos/xdg/foot/foot.ini
        etc/mindos/xdg/gtk-3.0/settings.ini etc/mindos/xdg/gtk-4.0/settings.ini)
source=(mindos-session session-startup greetd.toml greetd-mindos.conf greetd-vt mindwm.toml mindos.desktop foot.ini
        gtk-settings.ini mindos-portals.conf 90_mindos.gschema.override firefox-mindos.js)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP)

package() {
  install -Dm755 mindos-session   "$pkgdir/usr/bin/mindos-session"
  install -Dm755 session-startup  "$pkgdir/usr/lib/mindos/session-startup"
  install -Dm644 greetd.toml      "$pkgdir/etc/mindos/greetd.toml"
  install -Dm644 greetd-mindos.conf "$pkgdir/usr/lib/systemd/system/greetd.service.d/mindos.conf"
  install -Dm755 greetd-vt        "$pkgdir/usr/lib/mindos/greetd-vt"
  install -Dm644 mindwm.toml      "$pkgdir/etc/mindos/mindwm.toml"
  install -Dm644 mindos.desktop   "$pkgdir/usr/share/wayland-sessions/mindos.desktop"
  install -Dm644 foot.ini         "$pkgdir/etc/mindos/xdg/foot/foot.ini"
  # Same file for GTK 3 and GTK 4: font name plus the rendering settings GTK
  # will not take from fontconfig.
  install -Dm644 gtk-settings.ini "$pkgdir/etc/mindos/xdg/gtk-3.0/settings.ini"
  install -Dm644 gtk-settings.ini "$pkgdir/etc/mindos/xdg/gtk-4.0/settings.ini"
  # Dark mode for everything else: the settings portal (Firefox, GTK 4,
  # libadwaita) reads the GSettings colour scheme, Firefox also gets its own
  # defaults. The firefox directory is harmless when firefox is not installed.
  install -Dm644 mindos-portals.conf         "$pkgdir/usr/share/xdg-desktop-portal/mindos-portals.conf"
  install -Dm644 90_mindos.gschema.override  "$pkgdir/usr/share/glib-2.0/schemas/90_mindos.gschema.override"
  install -Dm644 firefox-mindos.js           "$pkgdir/usr/lib/firefox/defaults/pref/mindos.js"
  install -dm755 "$pkgdir/etc/xdg/mindos/autostart"
}
