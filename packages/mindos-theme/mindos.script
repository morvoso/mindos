# MindOS boot splash: the same dark ground the desktop uses, a wordmark and a
# thin progress line. Nothing bright ever reaches the screen between the
# firmware and the login screen, and no unit names scroll past: the boot is
# quiet by design, and anything that goes wrong is on tty2 and in the journal.
Window.SetBackgroundTopColor(0.020, 0.027, 0.039);
Window.SetBackgroundBottomColor(0.051, 0.063, 0.086);
screen.x = Window.GetX(); screen.y = Window.GetY();
screen.w = Window.GetWidth(); screen.h = Window.GetHeight();
s = screen.h / 900;
if (s < 0.5) s = 0.5;
left = screen.x + 65*s;
# text kinds: 0 = wordmark, 1 = the highlight, 2 = quiet grey
fun label(text, x, y, size, kind)
{
  if (kind == 1) image = Image.Text(text, 0.21, 0.75, 0.36, 1, "Sans Bold " + size);
  else if (kind == 2) image = Image.Text(text, 0.42, 0.47, 0.53, 1, "Monospace " + size);
  else image = Image.Text(text, 0.92, 0.94, 0.96, 1, "Sans Bold " + size);
  sprite = Sprite(image); sprite.SetPosition(x, y, 10); return sprite;
}
brand = label("MIND\nOS", left, screen.y + screen.h*0.40, Math.Int(110*s), 0);
edition = label("MINDOS / BUILT FOR PLAY", left, screen.y+70*s, Math.Int(12*s), 2);
# Scale a text glyph into a solid rule; no screen-sized bitmap or animation.
rule.image = Image.Text("█", 0.13, 0.15, 0.18);
accent.image = Image.Text("█", 0.21, 0.75, 0.36);
bar.x = left; bar.y = screen.y + screen.h-100*s;
bar.w = Math.Int(screen.w*0.42); bar.h = Math.Int(4*s);
bar.track = Sprite(rule.image.Scale(bar.w, bar.h)); bar.track.SetPosition(bar.x,bar.y,5);
bar.fill = Sprite(); bar.fill.SetPosition(bar.x,bar.y,6);
bar.progress = 0; elapsed = 0;
fun progress_callback(duration, progress)
{
  global.elapsed = duration;
  if (progress > bar.progress) bar.progress = progress;
  w = Math.Int(bar.w*bar.progress); if (w < 1) w = 1;
  bar.fill.SetImage(accent.image.Scale(w,bar.h));
}
Plymouth.SetBootProgressFunction(progress_callback);
# Systemd keeps sending unit names; the splash stays quiet and ignores them.
fun status_callback(status) { }
Plymouth.SetUpdateStatusFunction(status_callback);
message = Sprite();
fun display_message(text) { global.message = label(text,left,screen.y+screen.h-48*s,Math.Int(12*s),2); }
fun hide_message(text) { global.message = Sprite(); }
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
prompt = Sprite(); bullets = Sprite();
fun display_password(text, count)
{
  global.prompt = label(text,left,screen.y+screen.h*0.27,Math.Int(15*s),2);
  value = ""; for (i=0;i<count;i++) value = value + "● ";
  global.bullets = label(value,left,screen.y+screen.h*0.33,Math.Int(18*s),1);
}
fun display_question(text, entry)
{
  global.prompt = label(text,left,screen.y+screen.h*0.27,Math.Int(15*s),2);
  global.bullets = label(entry,left,screen.y+screen.h*0.33,Math.Int(18*s),0);
}
fun normal() { global.prompt = Sprite(); global.bullets = Sprite(); }
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayNormalFunction(normal);
fun quit() { bar.fill.SetImage(accent.image.Scale(bar.w,bar.h)); }
Plymouth.SetQuitFunction(quit);
