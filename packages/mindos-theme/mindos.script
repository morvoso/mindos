# MindOS Plymouth theme: white on MindOS red (#8c1010).
Window.SetBackgroundTopColor(0.549, 0.063, 0.063);
Window.SetBackgroundBottomColor(0.549, 0.063, 0.063);

# Wordmark, centred slightly above the middle.
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

# Progress bar: a 1x1 white pixel scaled to the current progress over a faint track.
bar.pixel = Image("bar.png");
bar.width = Math.Int(Window.GetWidth() / 3);
bar.height = 6;
bar.x = Window.GetX() + Window.GetWidth() / 2 - bar.width / 2;
bar.y = logo.y + logo.image.GetHeight() + 40;
bar.track = Sprite(bar.pixel.Scale(bar.width, bar.height));
bar.track.SetPosition(bar.x, bar.y, 5);
bar.track.SetOpacity(0.25);
bar.fill = Sprite(bar.pixel.Scale(1, bar.height));
bar.fill.SetPosition(bar.x, bar.y, 6);
bar.progress = 0;

fun progress_callback(duration, progress)
{
  if (progress > bar.progress) bar.progress = progress;
  w = Math.Int(bar.width * bar.progress);
  if (w < 1) w = 1;
  bar.fill.SetImage(bar.pixel.Scale(w, bar.height));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Status messages (fsck, "Starting ...") bottom left.
message.sprite = Sprite();
message.sprite.SetPosition(Window.GetX() + 24, Window.GetY() + Window.GetHeight() - 48, 20);
fun display_message_callback(text)
{
  message.sprite.SetImage(Image.Text(text, 1, 1, 1));
}
fun hide_message_callback(text)
{
  message.sprite.SetImage(Image.Text("", 1, 1, 1));
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

# Password prompt (encrypted disks): prompt text and bullets under the bar.
prompt.sprite = Sprite();
bullets.sprite = Sprite();
fun display_password_callback(prompt_text, bullet_count)
{
  global.status = "password";
  img = Image.Text(prompt_text, 1, 1, 1);
  prompt.sprite.SetImage(img);
  prompt.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - img.GetWidth() / 2, bar.y + 30, 20);
  dots = "";
  for (i = 0; i < bullet_count; i++) dots += "* ";
  bimg = Image.Text(dots, 1, 1, 1);
  bullets.sprite.SetImage(bimg);
  bullets.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - bimg.GetWidth() / 2, bar.y + 60, 20);
}
fun display_normal_callback()
{
  global.status = "normal";
  prompt.sprite.SetImage(Image.Text("", 1, 1, 1));
  bullets.sprite.SetImage(Image.Text("", 1, 1, 1));
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun quit_callback()
{
  bar.fill.SetImage(bar.pixel.Scale(bar.width, bar.height));
}
Plymouth.SetQuitFunction(quit_callback);
