# Maintainer: MindOS <build@mindos.local>
pkgname=mindos-theme
pkgver=0.5.0
pkgrel=3
pkgdesc="MindOS look: white-on-red boot menu and console (boot stage), modernist Plymouth boot trace, fonts and font rendering, wallpaper and icon"
arch=(any)
url="https://github.com/morvoso/mindos"
license=('LicenseRef-MindOS' OFL-1.1)
depends=(plymouth util-linux fontconfig inter-font ttf-jetbrains-mono noto-fonts noto-fonts-emoji)
makedepends=()
# Plymouth sprites, wallpaper, splash and icon are generated by gen-assets.py
# (python-pillow, python-numpy) from the fonts in fonts/; the PNGs are committed.
source=(limine-theme.conf
        49-mindos-rendering.conf 59-mindos-fonts.conf
        mindos.plymouth mindos.script gen-assets.py
        logo.png logo-glow.png caption-boot.png caption-halt.png
        bar.png px-track.png px-fill.png px-line.png bar-head.png scan.png bullet.png
        corner-tl.png corner-tr.png corner-bl.png corner-br.png
        wallpaper.png mindos.png splash.png console-theme mindos-console-theme.service)
sha256sums=(SKIP
            SKIP SKIP
            SKIP SKIP SKIP
            SKIP SKIP SKIP SKIP
            SKIP SKIP SKIP SKIP SKIP SKIP SKIP
            SKIP SKIP SKIP SKIP
            SKIP SKIP SKIP SKIP SKIP)

package() {
  # The boot menu colours; mindos-boot (mindos-base) folds them into /boot/limine.conf.
  install -Dm644 limine-theme.conf "$pkgdir/usr/share/mindos/limine-theme.conf"

  local t="$pkgdir/usr/share/plymouth/themes/mindos"
  install -Dm644 mindos.plymouth "$t/mindos.plymouth"
  install -Dm644 mindos.script   "$t/mindos.script"
  local f
  for f in logo.png logo-glow.png caption-boot.png caption-halt.png \
           bar.png px-track.png px-fill.png px-line.png bar-head.png scan.png bullet.png \
           corner-tl.png corner-tr.png corner-bl.png corner-br.png; do
    install -Dm644 "$f" "$t/$f"
  done

  install -Dm644 wallpaper.png   "$pkgdir/usr/share/mindos/wallpaper.png"
  install -Dm644 splash.png      "$pkgdir/usr/share/mindos/splash.png"
  install -Dm644 mindos.png      "$pkgdir/usr/share/pixmaps/mindos.png"
  install -Dm755 gen-assets.py   "$pkgdir/usr/share/mindos/theme/gen-assets.py"
  install -Dm755 console-theme   "$pkgdir/usr/lib/mindos/console-theme"
  install -Dm644 mindos-console-theme.service "$pkgdir/usr/lib/systemd/system/mindos-console-theme.service"

  # The MindOS display fonts (Orbitron and Share Tech Mono; SIL OFL), used by
  # Plymouth and by the shell's wordmark. The text faces are the packaged
  # Inter and JetBrains Mono, pulled in through depends. makepkg only accepts
  # flat local sources, so these are installed straight from the package
  # directory.
  install -dm755 "$pkgdir/usr/share/fonts/mindos" "$pkgdir/usr/share/licenses/$pkgname"
  install -m644 "$startdir"/fonts/*.ttf "$pkgdir/usr/share/fonts/mindos/"
  install -m644 "$startdir"/fonts/OFL-*.txt "$pkgdir/usr/share/licenses/$pkgname/"

  # Font rendering and family defaults: available to fontconfig and enabled,
  # the way distribution font packages do it, so an administrator can drop
  # either symlink to go back to the stock behaviour.
  local c
  for c in 49-mindos-rendering.conf 59-mindos-fonts.conf; do
    install -Dm644 "$c" "$pkgdir/usr/share/fontconfig/conf.avail/$c"
    install -dm755 "$pkgdir/etc/fonts/conf.d"
    ln -sf "/usr/share/fontconfig/conf.avail/$c" "$pkgdir/etc/fonts/conf.d/$c"
  done

  # The MindOS licence: a custom licence, so pacman wants it under the package.
  install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
