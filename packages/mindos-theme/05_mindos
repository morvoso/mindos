#!/bin/sh
# MindOS GRUB colors: white text on MindOS red (#8c1010). "black" backgrounds
# are transparent in gfxterm, so the background_color shows through.
cat <<'GRUB'
if [ "${grub_platform}" = "efi" -o "${grub_platform}" = "pc" ]; then
  insmod all_video
fi
if [ x"${feature_all_video_module}" = xy -o "${grub_platform}" != "" ]; then
  background_color 140,16,16
fi
set color_normal=white/black
set color_highlight=red/white
set menu_color_normal=white/black
set menu_color_highlight=red/white
GRUB
