#!/bin/bash
# console-theme: white text on MindOS red for the virtual consoles. The kernel
# command line (vt.color, vt.default_red/grn/blu) already brings the machine up
# this way; this re-applies it once userspace is running, so a console opened
# later is themed too, and keeps the palette entry exact.
for n in 1 2 3 4 5 6; do
  tty=/dev/tty$n
  [[ -w $tty ]] || continue
  # palette slot 4 (blue) becomes MindOS red, 7/15 are pure white
  printf '\e]P48c1010\e]P7ffffff\e]PFffffff' > "$tty" 2>/dev/null || true
  setterm --term linux --background blue --foreground white --store > "$tty" 2>/dev/null || true
done
exit 0
