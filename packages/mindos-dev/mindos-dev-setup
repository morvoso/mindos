#!/bin/bash
# mindos-dev-setup — one-time developer setup for MindOS. Run as your own user.
#
#   mindos-dev-setup                 Rust toolchain, Docker, VS Code defaults, git identity
#   mindos-dev-setup --status        tool versions and Docker state
#   mindos-dev-setup --status --json the same as JSON (used by Settings › Developer)
#
# Every step is skipped when it is already done, so the command can be run
# again at any time. sudo is used only for Docker (the service and the group)
# and says so before asking for a password.

set -u

STATUS=0 JSON=0
for a in "$@"; do
  case $a in
    --status) STATUS=1;;
    --json) JSON=1;;
    -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    *) echo "mindos-dev-setup: unknown option $a" >&2; exit 2;;
  esac
done

have() { command -v "$1" >/dev/null 2>&1; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$*"; }
skip() { printf '\033[2m·\033[0m %s\n' "$*"; }
step() { printf '\033[36m→\033[0m %s\n' "$*"; }
warn() { printf '\033[35m!\033[0m %s\n' "$*" >&2; }

# ----- status ---------------------------------------------------------------
TOOLS=(rustc cargo node npm python go docker podman)

tool_version() { # first x.y[.z] token of `$1 --version` (go: `go version`), empty if missing
  local out
  have "$1" || return 0
  case $1 in
    go) out=$(go version 2>/dev/null);;
    *)  out=$(timeout 5 "$1" --version 2>/dev/null | head -n1);;
  esac
  grep -oE '[0-9]+(\.[0-9]+)+[0-9A-Za-z.+-]*' <<<"$out" | head -n1
}

docker_active()  { have systemctl && systemctl is-active  --quiet docker.service 2>/dev/null; }
docker_enabled() { have systemctl && systemctl is-enabled --quiet docker.service 2>/dev/null; }
docker_member()  { id -nG 2>/dev/null | tr ' ' '\n' | grep -qx docker; }
bool() { "$@" && echo true || echo false; }
json_str() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "$s"; }

status_json() {
  local t v first=1
  printf '{"tools":['
  for t in "${TOOLS[@]}"; do
    v=$(tool_version "$t")
    [ $first = 1 ] || printf ','
    first=0
    printf '{"name":%s,"version":%s}' "$(json_str "$t")" "$([ -n "$v" ] && json_str "$v" || echo null)"
  done
  printf '],"docker":{"active":%s,"enabled":%s,"member":%s}}\n' \
    "$(bool docker_active)" "$(bool docker_enabled)" "$(bool docker_member)"
}

status_text() {
  local t v
  for t in "${TOOLS[@]}"; do
    v=$(tool_version "$t")
    if [ -n "$v" ]; then printf '\033[32m✓\033[0m %-8s %s\n' "$t" "$v"
    else printf '\033[2m–\033[0m %-8s not installed\n' "$t"; fi
  done
  printf '%-10s service %s, %s at boot, %s\n' docker \
    "$(docker_active && echo running || echo stopped)" \
    "$(docker_enabled && echo enabled || echo disabled)" \
    "$(docker_member && echo "$USER is in the docker group" || echo "$USER is not in the docker group")"
}

if [ $STATUS = 1 ]; then
  if [ $JSON = 1 ]; then status_json; else status_text; fi
  exit 0
fi

# ----- setup ----------------------------------------------------------------
if [ "$(id -u)" = 0 ]; then
  echo "mindos-dev-setup: run this as your own user, not root (it uses sudo where needed)." >&2
  exit 1
fi

DONE=()

# Rust: rustup is installed by the package, the toolchain is per user.
if have rustup; then
  if rustup show active-toolchain >/dev/null 2>&1; then
    skip "rust: $(rustup show active-toolchain 2>/dev/null | head -n1 | cut -d' ' -f1) is the default toolchain"
  else
    step "rust: installing the stable toolchain (rustup default stable)"
    if rustup default stable; then DONE+=("Rust stable toolchain installed"); else warn "rustup default stable failed (offline?)"; fi
  fi
  if rustup show active-toolchain >/dev/null 2>&1; then
    missing=()
    installed=$(rustup component list --installed 2>/dev/null)
    for c in rust-analyzer clippy rustfmt; do
      grep -q "^$c" <<<"$installed" || missing+=("$c")
    done
    if [ ${#missing[@]} -gt 0 ]; then
      step "rust: adding ${missing[*]}"
      rustup component add "${missing[@]}" && DONE+=("Rust components: ${missing[*]}")
    else
      skip "rust: rust-analyzer, clippy and rustfmt are installed"
    fi
  fi
else
  skip "rust: rustup not installed"
fi

# Docker: the service and the group. Podman needs nothing (rootless by default).
if have docker && have systemctl; then
  if docker_enabled && docker_active; then
    skip "docker: service enabled and running"
  else
    step "docker: enabling and starting docker.service and docker.socket (sudo)"
    if sudo systemctl enable --now docker.service docker.socket; then
      DONE+=("Docker service enabled and started")
    else
      warn "could not enable docker (sudo systemctl enable --now docker.service docker.socket)"
    fi
  fi
  if docker_member; then
    skip "docker: $USER is in the docker group"
  else
    step "docker: adding $USER to the docker group (sudo)"
    if sudo usermod -aG docker "$USER"; then
      DONE+=("$USER added to the docker group: log out and back in before using docker without sudo")
    else
      warn "could not add $USER to the docker group (sudo usermod -aG docker $USER)"
    fi
  fi
else
  skip "docker: not installed"
fi

# VS Code (Code - OSS): dark theme, JetBrains Mono, no telemetry. Only if the
# user has no settings yet.
CODE_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/Code\ -\ OSS/User
if [ -e "$CODE_DIR/settings.json" ]; then
  skip "vs code: $CODE_DIR/settings.json exists"
else
  mkdir -p "$CODE_DIR" && cat > "$CODE_DIR/settings.json" <<'JSON'
{
  "workbench.colorTheme": "Default Dark Modern",
  "window.titleBarStyle": "custom",
  "editor.fontFamily": "'JetBrains Mono', monospace",
  "editor.fontLigatures": true,
  "editor.formatOnSave": false,
  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
  "telemetry.telemetryLevel": "off",
  "update.mode": "none"
}
JSON
  DONE+=("VS Code defaults written to $CODE_DIR/settings.json")
fi

# git identity: ask only when missing and someone is there to answer.
if have git; then
  name=$(git config --global user.name 2>/dev/null || true)
  email=$(git config --global user.email 2>/dev/null || true)
  if [ -n "$name" ] && [ -n "$email" ]; then
    skip "git: commits as $name <$email>"
  elif [ -t 0 ]; then
    step "git: no global identity yet"
    [ -n "$name" ]  || { read -rp "  your name for commits: " name;  [ -n "$name" ]  && git config --global user.name "$name"; }
    [ -n "$email" ] || { read -rp "  your email for commits: " email; [ -n "$email" ] && git config --global user.email "$email"; }
    [ -n "$name" ] && [ -n "$email" ] && DONE+=("git identity set: $name <$email>")
  else
    skip "git: no identity set (run: git config --global user.name NAME; git config --global user.email EMAIL)"
  fi
fi

echo
if [ ${#DONE[@]} -eq 0 ]; then
  echo "Nothing to do: the developer stack is set up."
else
  for d in "${DONE[@]}"; do ok "$d"; done
fi
echo "Type 'mindos' in a shell for the MindOS commands; see /usr/share/doc/mindos-dev/README."
