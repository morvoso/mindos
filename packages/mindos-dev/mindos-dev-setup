#!/bin/bash
# mindos-dev-setup: developer setup for MindOS. Run as a normal user.
#
#   mindos-dev-setup                 per-user setup: Rust toolchain, Docker, editor and git defaults
#   mindos-dev-setup --status        report installed toolchains, tools, groups and services
#   mindos-dev-setup --status --json the same report as JSON (used by Settings › Developer)
#
# The mindos-dev package installs the build tools. This command performs the
# steps a package cannot: per-user toolchains, service state, group membership
# and configuration files in the home directory. It reports every toolchain
# it detects, whether or not mindos-dev installed it.
#
# Steps that are already complete are skipped, so the command can be run
# again at any time. sudo is used only where root is required, and each such
# step is announced before the password prompt.

set -u

STATUS=0 JSON=0
for a in "$@"; do
  case $a in
    --status) STATUS=1;;
    --json) JSON=1;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    *) echo "mindos-dev-setup: unknown option $a" >&2; exit 2;;
  esac
done

have() { command -v "$1" >/dev/null 2>&1; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$*"; }
skip() { printf '\033[2m·\033[0m %s\n' "$*"; }
step() { printf '\033[36m→\033[0m %s\n' "$*"; }
warn() { printf '\033[35m!\033[0m %s\n' "$*" >&2; }

# ----- toolchains -----------------------------------------------------------
# label|command|version arguments. Wider than the set mindos-dev installs;
# only toolchains that are present are reported.
TOOLCHAINS=(
  'C/C++|gcc|--version'          'Clang|clang|--version'
  'Rust|rustc|--version'         'Go|go|version'
  'Node.js|node|--version'       'Deno|deno|--version'
  'Bun|bun|--version'            'Python|python|--version'
  'Java|java|-version'           '.NET|dotnet|--version'
  'Zig|zig|version'              'Ruby|ruby|--version'
  'PHP|php|--version'            'Perl|perl|--version'
  'Lua|lua|-v'                   'Elixir|elixir|--version'
  'Haskell|ghc|--version'        'Swift|swift|--version'
  'Kotlin|kotlinc|-version'      'Crystal|crystal|--version'
  'Nim|nim|--version'            'Julia|julia|--version'
  'Dart|dart|--version'          'R|R|--version'
)

# Build, debug and container tools, reported when present.
TOOLS=(
  'git|git|--version'            'cmake|cmake|--version'
  'ninja|ninja|--version'        'mold|mold|--version'
  'sccache|sccache|--version'    'just|just|--version'
  'gdb|gdb|--version'            'lldb|lldb|--version'
  'perf|perf|--version'          'valgrind|valgrind|--version'
  'docker|docker|--version'      'podman|podman|--version'
  'distrobox|distrobox|--version'
)

# First x.y[.z] token of the version output, empty when the command is absent.
# java and kotlinc write to stderr; the 2>&1 covers them.
probe() { # probe CMD ARGS...
  local cmd=$1; shift
  have "$cmd" || return 0
  timeout 5 "$cmd" "$@" 2>&1 | head -n2 | grep -oE '[0-9]+(\.[0-9]+)+[0-9A-Za-z.+-]*' | head -n1
}

# ----- system state ---------------------------------------------------------
unit_active()  { have systemctl && systemctl is-active  --quiet "$1" 2>/dev/null; }
unit_enabled() { have systemctl && systemctl is-enabled --quiet "$1" 2>/dev/null; }
unit_exists()  { have systemctl && systemctl cat "$1" >/dev/null 2>&1; }
# Query by user name: bare `id -nG` reports the groups this process received
# at login, so a group joined since then would not appear. The group database
# is the state the page should report.
in_group()     { id -nG "${USER:-$(id -un)}" 2>/dev/null | tr ' ' '\n' | grep -qx "$1"; }
group_exists() { getent group "$1" >/dev/null 2>&1; }

# Groups that grant a normal user access to a device or service. Only groups
# that exist on this system are offered.
DEV_GROUPS=(
  'docker|Run Docker containers without sudo'
  'kvm|Access /dev/kvm for hardware-accelerated virtual machines'
  'libvirt|Manage virtual machines with libvirt and virt-manager'
  'uucp|Access serial ports (microcontrollers, debug adapters)'
  'wireshark|Capture network traffic without root access'
)

sysctl_val() { sysctl -n "$1" 2>/dev/null || echo ''; }

ssh_keys() { # "path<TAB>type<TAB>comment" per public key in ~/.ssh
  local f
  for f in "$HOME"/.ssh/*.pub; do
    [ -e "$f" ] || continue
    ssh-keygen -l -f "$f" 2>/dev/null | awk -v p="$f" '{t=$NF; gsub(/[()]/,"",t); print p"\t"t"\t"$3}'
  done
}

# ----- json -----------------------------------------------------------------
json_str() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; printf '"%s"' "$s"; }
json_or_null() { [ -n "${1:-}" ] && json_str "$1" || printf null; }
json_num() { [ -n "${1:-}" ] && printf '%s' "$1" || printf null; }
bool() { "$@" && echo true || echo false; }

json_versions() { # json_versions ENTRY... -> [{"name":..,"version":..}] (installed only)
  local e label cmd args v first=1
  printf '['
  for e in "$@"; do
    IFS='|' read -r label cmd args <<<"$e"
    v=$(probe "$cmd" "$args")
    [ -n "$v" ] || continue
    [ $first = 1 ] || printf ','
    first=0
    printf '{"name":%s,"cmd":%s,"version":%s}' "$(json_str "$label")" "$(json_str "$cmd")" "$(json_str "$v")"
  done
  printf ']'
}

status_json() {
  local g name help first port kpath ktype kcomment
  printf '{"toolchains":'; json_versions "${TOOLCHAINS[@]}"
  printf ',"tools":';      json_versions "${TOOLS[@]}"

  printf ',"docker":{"installed":%s,"active":%s,"enabled":%s,"member":%s}' \
    "$(bool have docker)" "$(bool unit_active docker.service)" \
    "$(bool unit_enabled docker.service)" "$(bool in_group docker)"
  printf ',"podman":{"installed":%s}' "$(bool have podman)"

  port=$(awk '/^[[:space:]]*Port[[:space:]]+[0-9]+/ {p=$2} END {if (p) print p}' /etc/ssh/sshd_config 2>/dev/null)
  printf ',"ssh":{"installed":%s,"active":%s,"enabled":%s,"port":%s,"new_key":%s,"keys":[' \
    "$(bool unit_exists sshd.service)" "$(bool unit_active sshd.service)" \
    "$(bool unit_enabled sshd.service)" "$(json_num "${port:-22}")" \
    "$(json_str "$HOME/.ssh/id_ed25519")"
  first=1
  while IFS=$'\t' read -r kpath ktype kcomment; do
    [ -n "$kpath" ] || continue
    [ $first = 1 ] || printf ','
    first=0
    printf '{"path":%s,"type":%s,"comment":%s}' "$(json_str "$kpath")" "$(json_str "$ktype")" "$(json_str "$kcomment")"
  done <<<"$(ssh_keys)"
  printf ']}'

  printf ',"groups":['
  first=1
  for g in "${DEV_GROUPS[@]}"; do
    IFS='|' read -r name help <<<"$g"
    group_exists "$name" || continue
    [ $first = 1 ] || printf ','
    first=0
    printf '{"name":%s,"help":%s,"member":%s}' "$(json_str "$name")" "$(json_str "$help")" "$(bool in_group "$name")"
  done
  printf ']'

  printf ',"limits":{"inotify_watches":%s,"inotify_instances":%s,"perf_paranoid":%s}' \
    "$(json_num "$(sysctl_val fs.inotify.max_user_watches)")" \
    "$(json_num "$(sysctl_val fs.inotify.max_user_instances)")" \
    "$(json_num "$(sysctl_val kernel.perf_event_paranoid)")"

  printf ',"git":{"name":%s,"email":%s}' \
    "$(json_or_null "$(git config --global user.name 2>/dev/null)")" \
    "$(json_or_null "$(git config --global user.email 2>/dev/null)")"
  printf ',"user":%s}\n' "$(json_str "${USER:-$(id -un)}")"
}

status_text() {
  local e label cmd args v g name help
  echo "Toolchains"
  for e in "${TOOLCHAINS[@]}"; do
    IFS='|' read -r label cmd args <<<"$e"
    v=$(probe "$cmd" "$args")
    [ -n "$v" ] && printf '  \033[32m✓\033[0m %-10s %s\n' "$label" "$v"
  done
  echo "Tools"
  for e in "${TOOLS[@]}"; do
    IFS='|' read -r label cmd args <<<"$e"
    v=$(probe "$cmd" "$args")
    [ -n "$v" ] && printf '  \033[32m✓\033[0m %-10s %s\n' "$label" "$v"
  done
  echo "Groups"
  for g in "${DEV_GROUPS[@]}"; do
    IFS='|' read -r name help <<<"$g"
    group_exists "$name" || continue
    printf '  %s %-10s %s\n' "$(in_group "$name" && echo $'\033[32m✓\033[0m' || echo $'\033[2m–\033[0m')" "$name" "$help"
  done
  echo "Services"
  printf '  docker  %s, %s at boot\n' \
    "$(unit_active docker.service && echo running || echo stopped)" \
    "$(unit_enabled docker.service && echo enabled || echo disabled)"
  if unit_exists sshd.service; then
    printf '  sshd    %s, %s at boot\n' \
      "$(unit_active sshd.service && echo running || echo stopped)" \
      "$(unit_enabled sshd.service && echo enabled || echo disabled)"
  fi
}

if [ $STATUS = 1 ]; then
  if [ $JSON = 1 ]; then status_json; else status_text; fi
  exit 0
fi

# ----- setup ----------------------------------------------------------------
if [ "$(id -u)" = 0 ]; then
  echo "mindos-dev-setup: run as a normal user, not as root. sudo is used where required." >&2
  exit 1
fi

DONE=()

# Rust: the package installs rustup; the toolchain itself is per user.
# Skipped when rustup is not installed.
if have rustup; then
  if rustup show active-toolchain >/dev/null 2>&1; then
    skip "rust: $(rustup show active-toolchain 2>/dev/null | head -n1 | cut -d' ' -f1) is the default toolchain"
  else
    step "rust: installing the stable toolchain (rustup default stable)"
    if rustup default stable; then DONE+=("Rust stable toolchain installed"); else warn "rustup default stable failed. Check the network connection."; fi
  fi
  if rustup show active-toolchain >/dev/null 2>&1; then
    missing=()
    installed=$(rustup component list --installed 2>/dev/null)
    for c in rust-analyzer clippy rustfmt; do
      grep -q "^$c" <<<"$installed" || missing+=("$c")
    done
    if [ ${#missing[@]} -gt 0 ]; then
      step "rust: adding ${missing[*]}"
      rustup component add "${missing[@]}" && DONE+=("Rust components: ${missing[*]}")
    else
      skip "rust: rust-analyzer, clippy and rustfmt are installed"
    fi
  fi
else
  skip "rust: rustup not installed"
fi

# Docker: the service and the group. Podman requires no setup.
if have docker && have systemctl; then
  if unit_enabled docker.service && unit_active docker.service; then
    skip "docker: service enabled and running"
  else
    step "docker: enabling and starting docker.service and docker.socket (sudo)"
    if sudo systemctl enable --now docker.service docker.socket; then
      DONE+=("Docker service enabled and started")
    else
      warn "could not enable docker (sudo systemctl enable --now docker.service docker.socket)"
    fi
  fi
  if in_group docker; then
    skip "docker: $USER is in the docker group"
  else
    step "docker: adding $USER to the docker group (sudo)"
    if sudo usermod -aG docker "$USER"; then
      DONE+=("$USER added to the docker group. Log out and back in to use docker without sudo.")
    else
      warn "could not add $USER to the docker group (sudo usermod -aG docker $USER)"
    fi
  fi
else
  skip "docker: not installed"
fi

# SSH key for git remotes and remote logins. Created only when the user
# confirms at a terminal; ssh-keygen prompts for the passphrase.
if have ssh-keygen; then
  if [ -n "$(ssh_keys)" ]; then
    skip "ssh: $(ssh_keys | wc -l) key(s) in ~/.ssh"
  elif [ -t 0 ]; then
    step "ssh: no key in ~/.ssh"
    read -rp "  Create an ed25519 key now? [y/N] " a
    if [[ ${a:-} =~ ^[Yy] ]]; then
      mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
      ssh-keygen -t ed25519 -C "$USER@$(hostname)" -f "$HOME/.ssh/id_ed25519" && DONE+=("SSH key created: ~/.ssh/id_ed25519.pub")
    fi
  else
    skip "ssh: no key in ~/.ssh. Create one with ssh-keygen or in Settings › Developer."
  fi
fi

# Editor defaults, written only when the user has none. VS Code (Code - OSS)
# is the graphical editor mindos-dev installs; neovim is not configured.
CODE_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/Code\ -\ OSS/User
if [ -e "$CODE_DIR/settings.json" ]; then
  skip "vs code: $CODE_DIR/settings.json exists"
elif [ -d "${XDG_CONFIG_HOME:-$HOME/.config}" ]; then
  mkdir -p "$CODE_DIR" && cat > "$CODE_DIR/settings.json" <<'JSON'
{
  "workbench.colorTheme": "Default Dark Modern",
  "window.titleBarStyle": "custom",
  "editor.fontFamily": "'JetBrains Mono', monospace",
  "editor.fontLigatures": true,
  "editor.formatOnSave": false,
  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
  "telemetry.telemetryLevel": "off",
  "update.mode": "none"
}
JSON
  DONE+=("VS Code defaults written to $CODE_DIR/settings.json")
fi

# git identity: prompted only when missing and a terminal is attached.
if have git; then
  name=$(git config --global user.name 2>/dev/null || true)
  email=$(git config --global user.email 2>/dev/null || true)
  if [ -n "$name" ] && [ -n "$email" ]; then
    skip "git: commits as $name <$email>"
  elif [ -t 0 ]; then
    step "git: no global identity set"
    [ -n "$name" ]  || { read -rp "  Name for commits: " name;  [ -n "$name" ]  && git config --global user.name "$name"; }
    [ -n "$email" ] || { read -rp "  Email address for commits: " email; [ -n "$email" ] && git config --global user.email "$email"; }
    [ -n "$name" ] && [ -n "$email" ] && DONE+=("git identity set: $name <$email>")
  else
    skip "git: no identity set. Set one in Settings › Developer or with git config --global."
  fi
fi

echo
if [ ${#DONE[@]} -eq 0 ]; then
  echo "No changes were needed. The developer setup is complete."
else
  for d in "${DONE[@]}"; do ok "$d"; done
fi
echo "Additional toolchains: mindos-pkg install NAME (see docs/PACKAGES.md)."
echo "Run 'mindos' for a list of MindOS commands. See /usr/share/doc/mindos-dev/README."
