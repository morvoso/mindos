# /etc/mindos/dev/zshrc — the MindOS developer shell for zsh (mindos-dev).
# zsh reads no system-wide file for this, so add to ~/.zshrc:
#   [ -r /etc/mindos/dev/zshrc ] && source /etc/mindos/dev/zshrc
# `command ls` / `command cat` always run the originals.

[[ -o interactive ]] || return 0

(( $+functions[compdef] )) || { autoload -Uz compinit && compinit }

if [[ -z $STARSHIP_CONFIG && ! -e ${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml ]]; then
  export STARSHIP_CONFIG=/etc/mindos/dev/starship.toml
fi
(( $+commands[starship] )) && eval "$(starship init zsh)"
(( $+commands[zoxide] ))   && eval "$(zoxide init zsh)"           # z DIR, zi
(( $+commands[direnv] ))   && eval "$(direnv hook zsh)"           # .envrc per project
(( $+commands[fzf] ))      && eval "$(fzf --zsh 2>/dev/null)"     # Ctrl-R, Ctrl-T, Alt-C

if (( $+commands[eza] )); then
  alias ls='eza --icons=auto --group-directories-first'
  alias ll='eza --icons=auto --group-directories-first -l --git'
  alias la='eza --icons=auto --group-directories-first -la --git'
else
  alias ll='ls -l' la='ls -la'
fi
(( $+commands[bat] ))     && alias cat='bat --paging=never'
(( $+commands[lazygit] )) && alias lg='lazygit'
[[ -z $EDITOR ]] && (( $+commands[nvim] )) && export EDITOR=nvim

mindos() {
  local row cmd
  for row in \
    'mind "..."         ask the Mind: it can read logs, install packages, fix configs' \
    'mindos-pkg         install/remove/search: MindOS + Arch repos, Flathub, AUR' \
    'mindos-perf        performance modes: status | set balanced|performance|quiet' \
    'mindos-dlss        DLSS presets and overrides for games' \
    'mindos-boot        boot menu and snapshots: list | restore | config' \
    'mindos-dev-setup   Rust toolchain, Docker, VS Code defaults, git identity (--status)'
  do
    cmd=${row%% *}
    if (( $+commands[$cmd] )); then print -r -- "$row"
    else print -rP -- "%F{8}$row  (not installed)%f"; fi
  done
}
