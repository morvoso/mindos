# Maintainer: MindOS <build@mindos.local>
pkgname=mindos-install
pkgver=0.1.0
pkgrel=15
pkgdesc="MindOS guided installer (run from the live ISO)"
arch=(any)
url="https://github.com/morvoso/mindos"
license=('LicenseRef-MindOS')
depends=(arch-install-scripts gptfdisk dosfstools btrfs-progs util-linux coreutils pciutils bash python parted)
backup=(etc/mindos/pacman-install.conf)
source=(mindos-install pacman-install.conf install-check.py install-gpu.py install-packages.py linux-mindos.preset)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP)

package() {
  install -Dm755 mindos-install "$pkgdir/usr/bin/mindos-install"
  install -Dm755 install-gpu.py "$pkgdir/usr/lib/mindos/install-gpu.py"
  install -Dm755 install-check.py "$pkgdir/usr/lib/mindos/install-check.py"
  install -Dm755 install-packages.py "$pkgdir/usr/lib/mindos/install-packages.py"
  install -Dm644 linux-mindos.preset "$pkgdir/usr/share/mindos/linux-mindos.preset"
  install -Dm644 pacman-install.conf "$pkgdir/etc/mindos/pacman-install.conf"

  install -Dm644 "$startdir/../../docs/GRAPHICS.md" "$pkgdir/usr/share/doc/mindos-install/GRAPHICS.md"

  # The MindOS licence: a custom licence, so pacman wants it under the package.
  install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
