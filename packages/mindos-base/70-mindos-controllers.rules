# MindOS: game controllers usable by the seated user (Steam Input, SDL hidapi, gamescope).
# USB
SUBSYSTEM=="usb", ATTRS{idVendor}=="045e", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="054c", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="057e", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="28de", MODE="0660", TAG+="uaccess"
# hidraw (USB)
KERNEL=="hidraw*", ATTRS{idVendor}=="045e", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="057e", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="28de", MODE="0660", TAG+="uaccess"
# hidraw (Bluetooth)
KERNEL=="hidraw*", KERNELS=="0005:045E:*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0005:054C:*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0005:057E:*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0005:28DE:*", MODE="0660", TAG+="uaccess"
# uinput for Steam Input / controller remapping
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", TAG+="uaccess", OPTIONS+="static_node=uinput"
