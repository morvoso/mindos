#!/bin/bash
# snapper plugin: keep the boot menu in step with the snapshots of /.
# snapper calls every executable in this directory whose name starts with a
# digit as: <stage> <subvolume> <fstype> <snapshot numbers...>
case ${1:-} in
  create-snapshot-post|delete-snapshot-post|modify-snapshot-post|rollback-post)
    [[ ${2:-} == / && -f /boot/limine.conf ]] || exit 0
    exec /usr/bin/mindos-boot sync --quiet
    ;;
esac
exit 0
