#!/usr/bin/env python3
"""Keep named Btrfs mounts valid when rollback replaces a subvolume's ID."""

import os
from pathlib import Path
import re
import shutil
import sys
import tempfile


def normalize(text):
    lines = []
    for line in text.splitlines(keepends=True):
        fields = list(re.finditer(r"\S+", line))
        if len(fields) >= 4 and not line.lstrip().startswith("#") and fields[2][0] == "btrfs":
            options = fields[3][0].split(",")
            if any(option.startswith("subvol=") and option != "subvol=" for option in options):
                options = [option for option in options if not option.startswith("subvolid=")]
                start, end = fields[3].span()
                line = line[:start] + ",".join(options) + line[end:]
        lines.append(line)
    return "".join(lines)


def update(path):
    path = Path(path)
    if path.is_symlink() or not path.is_file():
        raise ValueError(f"expected a regular fstab file: {path}")
    original = path.read_text()
    result = normalize(original)
    if result == original:
        return
    info = path.stat()
    fd, temp = tempfile.mkstemp(prefix=".fstab-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as out:
            out.write(result)
            out.flush()
            os.fsync(out.fileno())
        shutil.copystat(path, temp)
        if os.geteuid() == 0:
            os.chown(temp, info.st_uid, info.st_gid)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: fstab-paths FILE")
    update(sys.argv[1])
