#!/bin/bash
# mindos-perf — MindOS performance modes.
#
#   mindos-perf status [--json]      what is in effect right now
#   mindos-perf set MODE             balanced | performance | quiet (persisted)
#   mindos-perf apply                re-apply the persisted mode (boot service)
#   mindos-perf config KEY VALUE     edit /etc/mindos/perf.conf (GAME_MODE, MIND_SLEEPS_WHILE_GAMING,
#                                    SCX_SCHEDULER, SCX_ARGS, NVIDIA_POWER_LIMIT)
#   mindos-perf game-start|game-end  GameMode hooks: performance while a game runs
#   mindos-perf modes                the modes and what they do
#
# A mode is a set of knobs applied together: CPU frequency governor and
# energy-performance preference (amd-pstate / intel_pstate), turbo boost, the
# ACPI platform profile, the scheduler (sched_ext scx_lavd in performance
# mode, EEVDF+BORE otherwise), transparent huge pages, proactive compaction,
# and NVIDIA persistence mode. Settings live in /etc/mindos/perf.conf, the
# chosen mode in /var/lib/mindos/perf/mode. Members of the "mindos" group may
# run "set" and the game hooks through sudo without a password.

set -u

CONF=/etc/mindos/perf.conf
STATE_DIR=/var/lib/mindos/perf
RUN_DIR=/run/mindos/perf
MODE_FILE=$STATE_DIR/mode
GAME_FILE=$RUN_DIR/game
PREV_FILE=$RUN_DIR/prev-mode
NVIDIA_FILE=$RUN_DIR/nvidia    # GPU 0's name, persistence mode and power limit as last set here

# ----- defaults (perf.conf overrides) -----------------------------------------
GAME_MODE=performance          # mode while a game runs ("" keeps the current mode)
MIND_SLEEPS_WHILE_GAMING=1     # unload the Mind's model while a game runs
SCX_SCHEDULER=scx_lavd         # sched_ext scheduler for performance mode ("" = none)
SCX_ARGS=""                    # extra arguments for the scheduler
NVIDIA_POWER_LIMIT=default     # default | max | <watts>: applied in performance mode
[ -r "$CONF" ] && . "$CONF"

die() { echo "mindos-perf: $*" >&2; exit 1; }
w() { # write a sysfs/procfs value if the file exists; never fail the run
  local f=$1 v=$2
  [ -w "$f" ] || return 0
  { printf '%s\n' "$v" > "$f"; } 2>/dev/null || true
}
first() { for f in "$@"; do [ -r "$f" ] && { cat "$f" 2>/dev/null; return; }; done; echo ""; }
# readval VAR FILE...: what "first" prints, into VAR without forking (status
# runs every few seconds while the gaming desktop is up).
readval() {
  local -n _readval=$1; shift
  local f; _readval=""
  for f in "$@"; do
    [ -r "$f" ] || continue
    IFS= read -r -d '' _readval < "$f" 2>/dev/null || true
    while [[ $_readval == *$'\n' ]]; do _readval=${_readval%$'\n'}; done
    return 0
  done
}
have() { command -v "$1" >/dev/null 2>&1; }

need_root() { [ "$(id -u)" = 0 ] || die "$1 needs root (members of the mindos group: sudo -n mindos-perf $1)"; }

mode_into() { readval "$1" "$MODE_FILE"; local -n _mode=$1; _mode=${_mode//[[:space:]]/}; }
mode_get() { local m; mode_into m; printf '%s\n' "$m"; }
valid_mode() { case "$1" in balanced|performance|quiet) return 0;; esac; return 1; }

# Serialize mode/config/game transitions, including their hardware writes.
# Readers do not take the lock: rename publishes a complete value at once.
lock_state() {
  need_root "$1"
  mkdir -p "$RUN_DIR" || die "cannot create $RUN_DIR"
  exec 9>"$RUN_DIR/lock" || die "cannot open performance lock"
  flock -x 9 || die "cannot lock performance state"
  [ ! -r "$CONF" ] || . "$CONF"
}
save_value() {
  local path=$1 value=$2
  printf '%s\n' "$value" > "$path.tmp" && mv -f -- "$path.tmp" "$path" || die "cannot write $path"
}
games_into() {
  readval "$1" "$GAME_FILE"; local -n _games=$1
  [[ "$_games" =~ ^[0-9]{1,9}$ ]] || _games=0
  _games=$((10#$_games))
}
game_count() { local n; games_into n; printf '%s\n' "$n"; }

# ----- knobs ------------------------------------------------------------------
cpu_policies() { ls -d /sys/devices/system/cpu/cpufreq/policy* 2>/dev/null; }

set_governor() { # $1 governor, $2 epp
  local p gov epp=$2 avail
  for p in $(cpu_policies); do
    gov=$1
    avail=$(first "$p/scaling_available_governors")
    # Active pstate drivers offer powersave/performance, not schedutil.
    # Switch the governor BEFORE EPP: performance rejects a balanced EPP.
    if [ "$gov" = schedutil ]; then
      case " $avail " in *" schedutil "*) ;; *) gov=powersave;; esac
    fi
    if [ -n "$avail" ]; then
      case " $avail " in *" $gov "*) w "$p/scaling_governor" "$gov";; esac
    fi
    [ -e "$p/energy_performance_preference" ] && w "$p/energy_performance_preference" "$epp"
  done
}

set_boost() { # $1 1|0
  w /sys/devices/system/cpu/cpufreq/boost "$1"
  # intel_pstate uses the inverse flag
  if [ "$1" = 1 ]; then w /sys/devices/system/cpu/intel_pstate/no_turbo 0; else w /sys/devices/system/cpu/intel_pstate/no_turbo 1; fi
  # amd-pstate per-policy boost
  local p
  for p in $(cpu_policies); do w "$p/boost" "$1"; done
}

set_platform_profile() {
  local f=/sys/firmware/acpi/platform_profile want=$1 avail
  [ -e "$f" ] || return 0
  avail=$(first /sys/firmware/acpi/platform_profile_choices)
  for c in $want balanced; do
    case " $avail " in *" $c "*) w "$f" "$c"; return;; esac
  done
}

set_scheduler() { # $1 on|off
  local unit=mindos-scx.service
  local -a args=()
  read -r -a args <<< "$SCX_ARGS"
  if [ "$1" = on ] && [ -n "$SCX_SCHEDULER" ] && have "$SCX_SCHEDULER" && [ -d /sys/kernel/sched_ext ]; then
    if ! systemctl -q is-active "$unit" 2>/dev/null; then
      systemd-run -q --unit="$unit" --collect -p Nice=-10 --description="MindOS sched_ext scheduler ($SCX_SCHEDULER)" \
        "$(command -v "$SCX_SCHEDULER")" "${args[@]}" >/dev/null 2>&1 || true
    fi
  else
    systemctl -q is-active "$unit" 2>/dev/null && systemctl stop "$unit" >/dev/null 2>&1
  fi
  return 0
}

set_nvidia() { # $1 performance|balanced|quiet
  have nvidia-smi || return 0
  [ -e /dev/nvidiactl ] || return 0
  local field uuid limit persistence=1
  [ "$1" = quiet ] && persistence=0
  nvidia-smi -pm "$persistence" >/dev/null 2>&1
  case "$1:$NVIDIA_POWER_LIMIT" in
    performance:max) field=power.max_limit;;
    *) field=power.default_limit;;
  esac
  # Each GPU has its own supported limits; GPU 0's limit is not a system default.
  while IFS=, read -r uuid limit; do
    uuid=${uuid//[[:space:]]/}; limit=${limit//[[:space:]]/}
    case "$1:$NVIDIA_POWER_LIMIT" in performance:default|performance:max) ;; performance:*) limit=$NVIDIA_POWER_LIMIT;; esac
    [[ "$limit" =~ ^[0-9]+([.][0-9]+)?$ ]] || continue
    [ -n "$uuid" ] && nvidia-smi -i "$uuid" -pl "$limit" >/dev/null 2>&1
  done < <(nvidia-smi --query-gpu="uuid,$field" --format=csv,noheader,nounits 2>/dev/null)
  # The name, persistence mode and power limit only change here, so "status"
  # reads this file instead of asking the driver every time.
  local line
  line=$(nvidia-smi --query-gpu=name,persistence_mode,power.limit --format=csv,noheader,nounits 2>/dev/null | head -1)
  mkdir -p "$RUN_DIR"
  if [ -n "$line" ]; then save_value "$NVIDIA_FILE" "$line"; else rm -f "$NVIDIA_FILE"; fi
  return 0
}

apply_mode() {
  local m=$1
  case "$m" in
    performance)
      set_platform_profile performance
      set_governor performance performance
      set_boost 1
      w /sys/kernel/mm/transparent_hugepage/enabled always
      w /sys/kernel/mm/transparent_hugepage/defrag defer
      w /proc/sys/vm/compaction_proactiveness 0
      w /proc/sys/kernel/split_lock_mitigate 0
      w /proc/sys/vm/swappiness 10
      w /proc/sys/kernel/sched_autogroup_enabled 0
      set_scheduler on
      set_nvidia performance
      ;;
    balanced)
      set_platform_profile balanced
      set_governor schedutil balance_performance
      set_boost 1
      w /sys/kernel/mm/transparent_hugepage/enabled always
      w /sys/kernel/mm/transparent_hugepage/defrag madvise
      w /proc/sys/vm/compaction_proactiveness 20
      w /proc/sys/kernel/split_lock_mitigate 0
      w /proc/sys/vm/swappiness 30
      w /proc/sys/kernel/sched_autogroup_enabled 1
      set_scheduler off
      set_nvidia balanced
      ;;
    quiet)
      set_platform_profile low-power
      set_governor powersave power
      set_boost 0
      w /sys/kernel/mm/transparent_hugepage/enabled madvise
      w /sys/kernel/mm/transparent_hugepage/defrag madvise
      w /proc/sys/vm/compaction_proactiveness 20
      w /proc/sys/vm/swappiness 60
      w /proc/sys/kernel/sched_autogroup_enabled 1
      set_scheduler off
      set_nvidia quiet
      ;;
    *) die "unknown mode '$m' (balanced, performance, quiet)";;
  esac
  mkdir -p "$RUN_DIR"
  save_value "$RUN_DIR/effective" "$m"
  logger -t mindos-perf "mode $m applied" 2>/dev/null || true
}

# ----- Mind -------------------------------------------------------------------
mind_sleep() { # $1 on|off — as the invoking user if possible (group mindos)
  # Remember what this gaming interval did, even if its preference changes.
  if [ "$1" = on ]; then
    [ "$MIND_SLEEPS_WHILE_GAMING" = 1 ] || return 0
  else
    [ -f "$RUN_DIR/mind-slept" ] || return 0
  fi
  have mind || return 0
  [ "$1" != on ] || save_value "$RUN_DIR/mind-slept" 1
  local u=${SUDO_USER:-}
  if [ -n "$u" ] && [ "$(id -u)" = 0 ]; then
    timeout 5s runuser -u "$u" -- mind sleep "$1" >/dev/null 2>&1 || true
  else
    timeout 5s mind sleep "$1" >/dev/null 2>&1 || true
  fi
  [ "$1" != off ] || rm -f "$RUN_DIR/mind-slept"
}

# ----- status -----------------------------------------------------------------
# Read once into S_* and print as JSON or text without spawning anything:
# mindshell asks every few seconds while the gaming desktop is up, and the
# Mind asks after every switch.
status_read() {
  mode_into S_MODE; [ -n "$S_MODE" ] || S_MODE=balanced
  readval S_EFFECTIVE "$RUN_DIR/effective"; [ -n "$S_EFFECTIVE" ] || S_EFFECTIVE=$S_MODE
  games_into S_GAME
  readval S_GOVERNOR /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
  readval S_EPP /sys/devices/system/cpu/cpufreq/policy0/energy_performance_preference
  readval S_BOOST /sys/devices/system/cpu/cpufreq/boost /sys/devices/system/cpu/cpufreq/policy0/boost
  if [ -z "$S_BOOST" ] && [ -r /sys/devices/system/cpu/intel_pstate/no_turbo ]; then
    local no_turbo; readval no_turbo /sys/devices/system/cpu/intel_pstate/no_turbo
    [ "$no_turbo" = 0 ] && S_BOOST=1 || S_BOOST=0
  fi
  readval S_PROFILE /sys/firmware/acpi/platform_profile
  # the bracketed word of "always [madvise] never"
  local thp sep=""; readval thp /sys/kernel/mm/transparent_hugepage/enabled; S_THP=""
  while [[ $thp =~ \[([a-z]*)\](.*) ]]; do S_THP+=$sep${BASH_REMATCH[1]}; sep=$'\n'; thp=${BASH_REMATCH[2]}; done
  while [[ $S_THP == *$'\n' ]]; do S_THP=${S_THP%$'\n'}; done
  if [ -d /sys/kernel/sched_ext ]; then
    readval S_SCHEDULER /sys/kernel/sched_ext/root/ops
    [ -n "$S_SCHEDULER" ] || S_SCHEDULER="eevdf+bore"
  else
    S_SCHEDULER="eevdf"
  fi
  S_NVIDIA=false; S_GPU=""; S_POWER_LIMIT=""; S_PERSISTENCE=false
  if have nvidia-smi && [ -e /dev/nvidiactl ]; then
    local line=""
    if [ -r "$NVIDIA_FILE" ]; then
      IFS= read -r line < "$NVIDIA_FILE" || true
    else  # no mode applied yet this boot
      line=$(nvidia-smi --query-gpu=name,persistence_mode,power.limit --format=csv,noheader,nounits 2>/dev/null | head -1)
    fi
    if [ -n "$line" ]; then
      S_NVIDIA=true
      S_GPU=${line%%,*}; S_GPU=${S_GPU## }
      S_POWER_LIMIT=${line##*,}; S_POWER_LIMIT=${S_POWER_LIMIT## }
      local pm=${line#*,}; pm=${pm%%,*}; pm=${pm//[[:space:]]/}
      [ "$pm" != Enabled ] || S_PERSISTENCE=true
    fi
  fi
  S_CPU=""
  local l
  if [ -r /proc/cpuinfo ]; then
    while IFS= read -r l; do
      case $l in *"model name"*) S_CPU=${l##*: }; break;; esac
    done < /proc/cpuinfo
  fi
  readval S_DRIVER /sys/devices/system/cpu/cpufreq/policy0/scaling_driver
}

# json_string VAR TEXT: TEXT as a JSON string literal, escaped exactly as
# python's json.dumps does (ASCII only; a byte that is not UTF-8 becomes U+DCxx).
json_string() {
  local -n _json=$1
  local LC_ALL=C
  local s=$2 out='"' i n c1 c2 c3 cp lo hi len=${#2}
  for ((i = 0; i < len; i++)); do
    printf -v n '%d' "'${s:i:1}"
    if ((n == 34)); then out+='\"'
    elif ((n == 92)); then out+='\\'
    elif ((n >= 32 && n < 127)); then out+=${s:i:1}
    elif ((n == 10)); then out+='\n'
    elif ((n == 13)); then out+='\r'
    elif ((n == 9)); then out+='\t'
    elif ((n == 8)); then out+='\b'
    elif ((n == 12)); then out+='\f'
    elif ((n < 128)); then printf -v c1 '\\u%04x' "$n"; out+=$c1
    else
      cp=-1
      if ((n >= 0xC2 && n <= 0xDF && i + 1 < len)); then
        printf -v c1 '%d' "'${s:i+1:1}"
        ((c1 >= 0x80 && c1 <= 0xBF)) && { cp=$(( (n & 0x1F) << 6 | (c1 & 0x3F) )); ((i += 1)); }
      elif ((n >= 0xE0 && n <= 0xEF && i + 2 < len)); then
        printf -v c1 '%d' "'${s:i+1:1}"; printf -v c2 '%d' "'${s:i+2:1}"
        lo=0x80; hi=0xBF; ((n == 0xE0)) && lo=0xA0; ((n == 0xED)) && hi=0x9F
        ((c1 >= lo && c1 <= hi && c2 >= 0x80 && c2 <= 0xBF)) &&
          { cp=$(( (n & 0x0F) << 12 | (c1 & 0x3F) << 6 | (c2 & 0x3F) )); ((i += 2)); }
      elif ((n >= 0xF0 && n <= 0xF4 && i + 3 < len)); then
        printf -v c1 '%d' "'${s:i+1:1}"; printf -v c2 '%d' "'${s:i+2:1}"; printf -v c3 '%d' "'${s:i+3:1}"
        lo=0x80; hi=0xBF; ((n == 0xF0)) && lo=0x90; ((n == 0xF4)) && hi=0x8F
        ((c1 >= lo && c1 <= hi && c2 >= 0x80 && c2 <= 0xBF && c3 >= 0x80 && c3 <= 0xBF)) &&
          { cp=$(( (n & 0x07) << 18 | (c1 & 0x3F) << 12 | (c2 & 0x3F) << 6 | (c3 & 0x3F) )); ((i += 3)); }
      fi
      if ((cp < 0)); then printf -v c1 '\\udc%02x' "$n"
      elif ((cp < 0x10000)); then printf -v c1 '\\u%04x' "$cp"
      else printf -v c1 '\\u%04x\\u%04x' $(( 0xD800 + ((cp - 0x10000) >> 10) )) $(( 0xDC00 + ((cp - 0x10000) & 0x3FF) ))
      fi
      out+=$c1
    fi
  done
  _json=$out\"
}

status_json() {
  status_read
  local mode eff gamemode cpu driver gov epp prof thp sched scx gpu limit policy boost sleeps=false
  json_string mode "$S_MODE"; json_string eff "$S_EFFECTIVE"; json_string gamemode "$GAME_MODE"
  json_string cpu "$S_CPU"; json_string driver "$S_DRIVER"; json_string gov "$S_GOVERNOR"; json_string epp "$S_EPP"
  json_string prof "$S_PROFILE"; json_string thp "$S_THP"; json_string sched "$S_SCHEDULER"; json_string scx "$SCX_SCHEDULER"
  json_string gpu "$S_GPU"; json_string limit "$S_POWER_LIMIT"; json_string policy "$NVIDIA_POWER_LIMIT"
  case "$S_BOOST" in "") boost=null;; 1) boost=true;; *) boost=false;; esac
  [ "$MIND_SLEEPS_WHILE_GAMING" != 1 ] || sleeps=true
  printf '{"mode":%s,"effective":%s,"game":%s,"gameMode":%s,"mindSleeps":%s,"cpu":%s,"driver":%s,"governor":%s,"epp":%s,"boost":%s,"platformProfile":%s,"thp":%s,"scheduler":%s,"scx":%s,"nvidia":%s,"gpu":%s,"powerLimit":%s,"powerLimitPolicy":%s,"persistence":%s}\n' \
    "$mode" "$eff" "$S_GAME" "$gamemode" "$sleeps" "$cpu" "$driver" "$gov" "$epp" "$boost" "$prof" "$thp" \
    "$sched" "$scx" "$S_NVIDIA" "$gpu" "$limit" "$policy" "$S_PERSISTENCE"
}

status_text() {
  status_read
  local boost=off; [ "$S_BOOST" != 1 ] || boost=on
  printf 'mode:        %s' "$S_MODE"; [ "$S_GAME" = 0 ] || printf '  (game running: %s)' "$S_EFFECTIVE"; printf '\n'
  printf 'cpu:         %s\n' "$S_CPU"
  printf 'governor:    %s / epp %s / boost %s (%s)\n' "$S_GOVERNOR" "${S_EPP:--}" "$boost" "$S_DRIVER"
  printf 'scheduler:   %s\n' "$S_SCHEDULER"
  printf 'huge pages:  %s\n' "$S_THP"
  [ -z "$S_PROFILE" ] || printf 'platform:    %s\n' "$S_PROFILE"
  [ "$S_NVIDIA" != true ] || printf 'gpu:         %s (power limit %s W)\n' "$S_GPU" "$S_POWER_LIMIT"
  printf 'while gaming: %s' "${GAME_MODE:-unchanged}"; [ "$MIND_SLEEPS_WHILE_GAMING" != 1 ] || printf ', Mind sleeps'; printf '\n'
}

modes_text() {
  cat <<'EOF'
balanced     schedutil/EPP balance, boost on, EEVDF+BORE, THP always, proactive compaction on. The default.
performance  governor performance, EPP performance, boost on, sched_ext scx_lavd, THP always, no proactive
             compaction, swappiness 10, NVIDIA persistence mode. GameMode switches here while a game runs.
quiet        governor powersave, EPP power, boost off, low-power platform profile, THP madvise.
EOF
}

# ----- commands ---------------------------------------------------------------
cmd=${1:-status}
case "$cmd" in
  status)
    if [ "${2:-}" = "--json" ]; then status_json; else status_text; fi
    ;;
  get)
    m=$(mode_get); echo "${m:-balanced}"
    ;;
  modes)
    modes_text
    ;;
  set)
    lock_state set
    m=${2:-}; valid_mode "$m" || die "usage: mindos-perf set balanced|performance|quiet"
    mkdir -p "$STATE_DIR" "$RUN_DIR"
    save_value "$MODE_FILE" "$m"
    if [ "$(game_count)" != 0 ] && [ -n "$GAME_MODE" ]; then
      # a game is running: the new mode takes over when it ends
      save_value "$PREV_FILE" "$m"
      echo "mode $m saved; $GAME_MODE stays in effect until the game ends"
    else
      apply_mode "$m"
      echo "mode $m"
    fi
    ;;
  config)
    lock_state config
    key=${2:-}; val=${3-}
    case "$key" in
      GAME_MODE) [ -z "$val" ] || valid_mode "$val" || die "GAME_MODE: balanced|performance|quiet or empty";;
      MIND_SLEEPS_WHILE_GAMING) case "$val" in 0|1) ;; *) die "MIND_SLEEPS_WHILE_GAMING: 0|1";; esac;;
      SCX_SCHEDULER) [[ -z "$val" || "$val" =~ ^scx_[a-z0-9_]+$ ]] || die "SCX_SCHEDULER: scx_* or empty";;
      SCX_ARGS) case "$val" in *["'"'"'\`$]*) die "SCX_ARGS: no quotes or expansions";; esac;;
      NVIDIA_POWER_LIMIT) [[ "$val" = default || "$val" = max || "$val" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "NVIDIA_POWER_LIMIT: default|max|<watts>";;
      *) die "config: unknown key '$key'";;
    esac
    mkdir -p "$(dirname "$CONF")"; touch "$CONF"
    # Preserve comments and quote shell data literally (including SCX_ARGS).
    { sed "/^$key=/d" "$CONF"; printf '%s=%q\n' "$key" "$val"; } > "$CONF.tmp"
    chmod --reference="$CONF" "$CONF.tmp"
    mv -f -- "$CONF.tmp" "$CONF" || die "cannot write $CONF"
    echo "$key=$val"
    # a changed game/scheduler setting takes effect at the next mode switch;
    # the power limit applies now when performance mode is in effect
    if [ "$key" = NVIDIA_POWER_LIMIT ] && [ "$(first "$RUN_DIR/effective")" = performance ]; then
      . "$CONF"; set_nvidia performance
    fi
    ;;
  apply)
    lock_state apply
    m=$(mode_get); valid_mode "${m:-}" || m=balanced
    mkdir -p "$RUN_DIR"
    # A service restart must not make the shell/daemon think the game ended.
    if [ "$(game_count)" != 0 ] && [ -n "$GAME_MODE" ]; then m=$GAME_MODE; fi
    apply_mode "$m"
    ;;
  game-start)
    lock_state game-start
    n=$(game_count)
    save_value "$GAME_FILE" "$((n + 1))"
    if [ "$n" = 0 ]; then
      mind_sleep on
      if [ -n "$GAME_MODE" ]; then
        m=$(mode_get); save_value "$PREV_FILE" "${m:-balanced}"
        apply_mode "$GAME_MODE"
      fi
    fi
    ;;
  game-end)
    lock_state game-end
    n=$(game_count)
    [ "$n" != 0 ] || exit 0
    n=$((n - 1))
    save_value "$GAME_FILE" "$n"
    if [ "$n" = 0 ]; then
      rm -f "$PREV_FILE"
      m=$(mode_get); m=${m:-balanced}
      # GameMode restores its own saved governor before this hook; reapply
      # even when our effective-mode label already matches the user's wish.
      apply_mode "$m"
      mind_sleep off
    fi
    ;;
  -h|--help|help)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) die "unknown command '$cmd' (status, get, set, apply, config, game-start, game-end, modes)";;
esac
