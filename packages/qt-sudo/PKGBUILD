# MindOS builds this small Octopi dependency in the image build, never on a user's desktop.
pkgname=qt-sudo
pkgver=2.4.1
pkgrel=1
pkgdesc='Graphical authentication for Octopi'
arch=(x86_64)
url='https://github.com/aarnt/qt-sudo'
license=('LGPL-2.1-or-later')
depends=(qt6-base sudo)
makedepends=(qt6-tools)
_commit=f39b9112c823c9b8c3d41da8471c8f52bbd0e18c
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/aarnt/qt-sudo/tar.gz/$_commit")
sha256sums=('3ea6a6264aa8776d16ce8cbcfd70a9d40b59f4115224f954b484f0e76c372d71')

build() {
  cd "$pkgname-$_commit"
  qmake6 PREFIX=/usr CONFIG+=release CONFIG-=debug \
    QMAKE_CFLAGS="$CFLAGS" QMAKE_CXXFLAGS="$CXXFLAGS" QMAKE_LFLAGS="$LDFLAGS"
  make
}

package() {
  cd "$pkgname-$_commit"
  make INSTALL_ROOT="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
