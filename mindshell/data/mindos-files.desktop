[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse and manage your files
Exec=mindshell --app files %f
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;Utility;Core;
MimeType=inode/directory;
Keywords=folder;file;manager;browse;
StartupWMClass=mindos-files
